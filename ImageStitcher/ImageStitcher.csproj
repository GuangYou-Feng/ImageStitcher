<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ImageStitcher</AssemblyName>
    <RootNamespace>ImageStitcher</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    OpenCvSharp4.runtime.win ships build/*.props that copy the native payload into
    dll\x86 and dll\x64 subfolders of the output. .NET Framework's default DLL search
    only looks next to the executable, so those copies are never loaded - and the x86
    pair can never be used at all by an x64-only app. They account for ~158 MB per
    configuration, so drop them here and let the target below place the x64 payload
    where the loader actually finds it.
  -->
  <ItemGroup>
    <Content Remove="$(PkgOpenCvSharp4_runtime_win)\runtimes\win-x86\native\*.dll" />
    <Content Remove="$(PkgOpenCvSharp4_runtime_win)\runtimes\win-x64\native\*.dll" />
  </ItemGroup>

  <!--
    Copy the x64 natives next to the executable, which is where the default Windows
    DLL search finds OpenCvSharpExtern.dll.
  -->
  <Target Name="CopyOpenCvNative" AfterTargets="Build">
    <ItemGroup>
      <OpenCvNativeFile Include="$(PkgOpenCvSharp4_runtime_win)\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenCvNativeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="OpenCV native: copied @(OpenCvNativeFile->Count()) file(s) to $(OutDir)" />
  </Target>

</Project>
